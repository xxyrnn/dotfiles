// -*- mode: jsonc -*-

/////////////////////////////////////
/// ~/.config/waybar/config.jsonc ///
/// author: xxyrnn                ///
/////////////////////////////////////

{
    "layer": "top", /// bar at top layer
    "position": "top", /// bar position (top|bottom|left|right)
    "height": 35, /// bar height (remove for auto height)
    "margin": "5 5 0 5", /// bottom is 0 because hyprland window margin is 10 / 2 = 5
    "spacing": 10, /// gaps between modules (10px / 2 = 5px for each side)
    "mode": "dock",
    "reload_style_on_change": true,
    "gtk-layer-shell": true,

    /// choose the order of the modules
    "modules-left": ["hyprland/workspaces"],
    "modules-center": [],
    "modules-right": [
        "hyprland/language",
        "backlight",
        "wireplumber",
        "battery",
        "power-profiles-daemon",
        "tray",
        "clock",
        "custom/notification",
    ],

    /// modules configuration
    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "warp-on-scroll": false,
        "on-click": "activate",
        "format": "{id}",
        "format-icons": {
            "urgent": "",
            "focused": "",
            "default": "",
        },
        "persistent-workspaces": {
            "*": 10,
        },
    },

    "hyprland/language": {
        "format": "{}",
        "format-en": "EN",
        "format-it": "IT",
        "on-click": "hyprctl switchxkblayout at-translated-set-2-keyboard next",
    },
    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["", "", ""],
    },
    "wireplumber": {
        "scroll-step": 5, // %, can be a float
        "format": "{icon} {volume}%",
        "format-muted": "",
        "format-bluetooth": "{icon} {volume}%",
        "format-bluetooth-muted": "{icon}",
        "format-source": " {volume}%",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "headset": "",
            "default": ["", "", ""],
        },
        "on-click": "kitty wiremix",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    },
    "battery": {
        "states": {
            "warning": 20,
            "critical": 10,
        },
        "format": "{icon} {capacity}%",
        "format-full": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-alt": "{icon} {time}",
        "format-icons": ["", "", "", "", ""],
    },
    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
        "tooltip": true,
        "format-icons": {
            "default": "",
            "performance": "",
            "balanced": "",
            "power-saver": "",
        },
    },
    "tray": {
        "spacing": 5,
        "icons": {
            "blueman": "bluetooth",
        },
    },
    "clock": {
        "format": "{:%I:%M %p}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": "{:%d/%m/%Y}",
    },
    "custom/notification": {
        "tooltip": true,
        "format": "{icon}",
        "format-icons": {
            "notification": "󱅫",
            "none": "󰂜",
            "dnd-notification": "󰂠",
            "dnd-none": "󰪓",
            "inhibited-notification": "󰂛",
            "inhibited-none": "󰪑",
            "dnd-inhibited-notification": "󰂛",
            "dnd-inhibited-none": "󰪑",
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true,
    },
}
