color-link default "#cdd6f4,#1e1e2e"
color-link comment "#585b70"
color-link selection "#585b7099"
color-link hlsearch "#f9e2af99"

color-link identifier "#94e2d5"
color-link identifier.class "#94e2d5"
color-link identifier.var "#89b4fa"

color-link constant "#fab387"
color-link constant.number "#fab387"
color-link constant.string "#a6e3a1"

color-link symbol "#cdd6f4"
color-link symbol.brackets "#cdd6f4"
color-link symbol.tag "#94e2d5"

color-link type "#cba6f7"
color-link type.keyword "#cba6f7"

color-link special "#f5c2e7"
color-link statement "#cba6f7"
color-link preproc "#585b70"

color-link underlined "#89b4fa"
color-link error "bold #f38ba8"
color-link todo "bold #fab387"

color-link diff-added "#a6e3a1"
color-link diff-modified "#fab387"
color-link diff-deleted "#f38ba8"

color-link gutter-error "#f38ba8"
color-link gutter-warning "#f9e2af"

color-link scrollbar "#31324499"
color-link statusline "#cdd6f4,#181825"
color-link tabbar "#cdd6f4,#181825"
color-link indent-char "#8a8c9b"
color-link line-number "#8a8c9b"
color-link current-line-number "#cdd6f4"

color-link cursor-line "#585b70,#cdd6f4"
color-link color-column "#585b70"
color-link type.extended "default"
