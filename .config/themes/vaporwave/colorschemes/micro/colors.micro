color-link default "#f2e5bb,#0a0710"
color-link comment "#63173e"
color-link selection "#ab8e8899"
color-link hlsearch "#d9ad4099"

color-link identifier "#5ef0fd"
color-link identifier.class "#5ef0fd"
color-link identifier.var "#d9ad40"

color-link constant "#c4631f"
color-link constant.number "#c4631f"
color-link constant.string "#65bf8b"

color-link symbol "#f2e5bb"
color-link symbol.brackets "#f2e5bb"
color-link symbol.tag "#5ef0fd"

color-link type "#871550"
color-link type.keyword "#871550"

color-link special "#871550"
color-link statement "#871550"
color-link preproc "#ab8e88"

color-link underlined "#2730b1"
color-link error "bold #82222d"
color-link todo "bold #c4631f"

color-link diff-added "#65bf8b"
color-link diff-modified "#c4631f"
color-link diff-deleted "#82222d"

color-link gutter-error "#82222d"
color-link gutter-warning "#d9ad40"

color-link scrollbar "#f2e5bb99"
color-link statusline "#d2b9b2,#180c22"
color-link tabbar "#d2b9b2,#180c22"
color-link indent-char "#d2b9b2"
color-link line-number "#871550"
color-link current-line-number "#f2e5bb"

color-link cursor-line "#ab8e88,#f4e5bc"
color-link color-column "#ab8e88"
color-link type.extended "default"
