color-link default "#f4e5bc,#2a0938"
color-link comment "#ab8e88"
color-link selection "#ab8e8899"
color-link hlsearch "#daae4199"

color-link identifier "#61f0ff"
color-link identifier.class "#61f0ff"
color-link identifier.var "#daae41"

color-link constant "#c4631f"
color-link constant.number "#c4631f"
color-link constant.string "#65bf8c"

color-link symbol "#f4e5bc"
color-link symbol.brackets "#f4e5bc"
color-link symbol.tag "#61f0ff"

color-link type "#881550"
color-link type.keyword "#881550"

color-link special "#bf65bd"
color-link statement "#881550"
color-link preproc "#ab8e88"

color-link underlined "#2831b2"
color-link error "bold #82222d"
color-link todo "bold #c4631f"

color-link diff-added "#65bf8c"
color-link diff-modified "#c4631f"
color-link diff-deleted "#82222d"

color-link gutter-error "#82222d"
color-link gutter-warning "#daae41"

color-link scrollbar "#ab8e8899"
color-link statusline "#0b0811"
color-link tabbar "#0b0811"
color-link indent-char "#d2b9b4"
color-link line-number "#d2b9b4"
color-link current-line-number "#f4e5bc"

color-link cursor-line "#ab8e88,#f4e5bc"
color-link color-column "#ab8e88"
color-link type.extended "default"
