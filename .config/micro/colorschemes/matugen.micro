color-link default "#e2e2e9"
color-link comment "#8f9099"
color-link selection "#162e60,#2f4578"
color-link hlsearch "#c0c6dc"

color-link identifier "#b1c6ff"
color-link identifier.class "#b1c6ff"
color-link identifier.var "#b1c6ff"

color-link constant "#e0bbdd"
color-link constant.number "#e0bbdd"
color-link constant.string "#c0c6dc"

color-link symbol "#593d59"
color-link symbol.brackets "#c5c6d0"
color-link symbol.tag "#b1c6ff"

color-link type "#b1c6ff"
color-link type.keyword "#c0c6dc"

color-link special "#593d59"
color-link statement "#2f4578"
color-link preproc "#593d59"

color-link underlined "#c0c6dc"
color-link error "bold #ffb4ab"
color-link todo "bold #e0bbdd"

color-link diff-added "#c0c6dc"
color-link diff-modified "#e0bbdd"
color-link diff-deleted "#ffb4ab"

color-link gutter-error "#ffb4ab"
color-link gutter-warning "#e0bbdd"

color-link scrollbar "#c5c6d0"
color-link statusline "#e2e2e9,#121318"
color-link tabbar "#e2e2e9,#121318"
color-link indent-char "#44464f"
color-link line-number "#44464f"
color-link current-line-number "#b1c6ff"

color-link cursor-line "#44464f,#e2e2e9"
color-link color-column "#44464f"
color-link type.extended "default"