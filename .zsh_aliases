######################
### ~/.zsh_aliases ###
######################

alias ls='lsd -lh'
alias grep='rg --color=auto'
alias ip='ip -c'
alias cl='clear'
alias cll='clear && ls'
alias clr='clear && fc -s'
alias py='python3.14'
alias cdf='cd "$(find ~ -type d | fzf)"'
alias cat='bat'
alias ff='fastfetch'
